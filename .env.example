# Postgres DB Environment
POSTGRES_USER=kcs1959
POSTGRES_PASSWORD=NonSugar
POSTGRES_DB=hccc_judge
# Major version image (postgres:18-alpine). Bumping across major versions
# needs a dump/restore: see scripts/migrate-pg14-to-pg18.sh.
POSTGRES_IMAGE=postgres:18-alpine

# Postgres DB Dev Environment
POSTGRES_PORT=5433

# web_server Environment
BACKEND_PORT=55301
CONTEST_BEGIN=2025-09-14T12:00:00+09:00
CONTEST_END=2025-09-16T12:00:00+09:00
RUST_LOG=web_server=info

# judge_server Environment (multi-replica claim tuning)
JUDGE_CLAIM_LIMIT=4
JUDGE_CLAIM_LEASE_SECS=300
JUDGE_POLL_MILLIS=5000

# FRONTEND Environment
FRONTEND_PORT=3000
ADMIN_USER_IDS=
